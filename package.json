{
  "name": "vibe-helper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "24.19.x",
    "pnpm": "11.12.x"
  },
  "scripts": {
    "preflight": "node ./scripts/check-toolchain.mjs",
    "core:init": "pnpm preflight && node apps/local-backend/dist/main.js init",
    "core:doctor": "pnpm preflight && node apps/local-backend/dist/main.js doctor",
    "core:start": "pnpm preflight && node apps/local-backend/dist/main.js start",
    "core:only": "pnpm preflight && node apps/local-backend/dist/main.js core-only",
    "core:native": "pnpm preflight && node apps/local-backend/dist/main.js native",
    "core:recover": "pnpm preflight && node apps/local-backend/dist/main.js recover",
    "client:build": "pnpm typecheck && node scripts/build-frontend-client.mjs",
    "client:pack": "pnpm client:build && pnpm --dir dist/frontend-client pack --out ../vibe-helper-frontend-client-0.1.0.tgz",
    "test:client-consumer": "pnpm preflight && node scripts/test-frontend-consumer.mjs",
    "panel:build": "pnpm typecheck && node scripts/build-kiro-panel.mjs",
    "panel:pack": "pnpm panel:build && node scripts/package-kiro-panel.mjs",
    "core:portable": "pnpm typecheck && node scripts/build-portable-core.mjs win32-x64",
    "panel:pack:windows": "pnpm core:portable && node scripts/package-windows-core.mjs",
    "frontend:handoff": "pnpm panel:pack:windows && pnpm client:build && node scripts/build-frontend-handoff.mjs",
    "test:portable": "pnpm core:portable && node scripts/test-portable-core.mjs",
    "test:managed": "pnpm core:portable && node scripts/test-managed-core.mjs",
    "test:managed-host": "pnpm panel:pack:windows && node scripts/test-managed-host.mjs",
    "test:project-tools": "pnpm core:portable && node scripts/test-project-tools.mjs",
    "build": "pnpm preflight && tsc -b --pretty false && node ./scripts/build-crew-agents.mjs && pnpm --filter @vibe-helper/crew-app build:bundle && node ./scripts/build-crew-package.mjs",
    "typecheck": "pnpm preflight && tsc -b --pretty false",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "db:check": "pnpm --filter @vibe-helper/storage-sqlite db:check",
    "test:unit": "pnpm preflight && vitest run tests/unit",
    "test:integration": "pnpm preflight && vitest run packages apps",
    "test:eval": "pnpm preflight && vitest run tests/eval",
    "test:campus-drop": "pnpm preflight && pnpm --filter @vibe-helper/campus-drop-fixture test",
    "test:eval:live-discovery": "pnpm preflight && pnpm build && node ./scripts/run-live-discovery-eval.mjs",
    "test:eval:live-spec": "pnpm preflight && pnpm build && node ./scripts/run-live-spec-eval.mjs",
    "test:eval:live-builder": "pnpm preflight && pnpm build && node ./scripts/run-live-builder-eval.mjs",
    "test:eval:live-helper": "pnpm preflight && pnpm build && node ./scripts/run-live-helper-eval.mjs",
    "test:eval:live-analyst": "pnpm preflight && pnpm build && node ./scripts/run-live-evidence-analyst-eval.mjs",
    "test:smoke": "pnpm preflight && vitest run tests/smoke",
    "test:e2e": "pnpm preflight && tsc -b --pretty false && playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm db:check && pnpm test:unit && pnpm test:integration && pnpm test:eval && pnpm test:campus-drop && pnpm build && pnpm test:smoke && pnpm test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
