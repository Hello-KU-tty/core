{
  "name": "vibe-helper",
  "version": "0.1.3",
  "displayName": "Vibe Helper",
  "description": "Learn unfamiliar development concepts by building a project you personally need.",
  "author": "hurdoo",
  "tags": ["learning", "developer-tools", "projects"],
  "defaultEnabled": false,
  "ui": {
    "entry": "dist/index-0.1.3.mjs",
    "pages": [{ "route": "/apps/vibe-helper", "label": "Vibe Helper", "icon": "Sprout" }]
  },
  "permissions": {
    "api": ["/apps/vibe-helper/api", "/api/chat", "/api/chat/slots", "/api/chat/slots/*"],
    "storage": false,
    "network": false,
    "events": []
  },
  "agents": [
    "agents/vibe-helper-discovery-preview.json",
    "agents/vibe-helper-discovery-enrichment.json",
    "agents/vibe-helper-discovery-round.json",
    "agents/vibe-helper-discovery-merge.json",
    "agents/vibe-helper-discovery-spec.json",
    "agents/vibe-helper-discovery-spec-recovery.json"
  ],
  "mcpServers": {
    "discovery-preview-core": {
      "url": "http://127.0.0.1:9100/mcp/discovery-preview"
    },
    "discovery-enrichment-core": {
      "url": "http://127.0.0.1:9100/mcp/discovery-enrichment"
    },
    "discovery-round-core": {
      "url": "http://127.0.0.1:9100/mcp/discovery-round"
    },
    "discovery-merge-core": {
      "url": "http://127.0.0.1:9100/mcp/discovery-merge"
    },
    "discovery-spec-core": {
      "url": "http://127.0.0.1:9100/mcp/discovery-spec"
    },
    "discovery-spec-recovery-core": {
      "url": "http://127.0.0.1:9100/mcp/discovery-spec-recovery"
    }
  },
  "backend": {
    "entryPoint": "apps/crew-backend/dist/main.js",
    "port": "auto",
    "healthCheck": "/health",
    "routes": "/apps/vibe-helper/api",
    "type": "node"
  }
}
